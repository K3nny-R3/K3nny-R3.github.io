---
import BlogList from '@components/blog/BlogList.astro';
import Layout from '@layouts/Default.astro';
import { getSortedPosts } from '../../lib/posts';

const posts = await getSortedPosts();
---

<Layout
  title='Noticias'
  description='Steam Noticias | Las últimas seis noticias sobre Steam y Valve'
  pageTitle='Steam Noticias'
>
  <main class='bg-steam-main p-6'>
    <h2 class='outfit steam-heading mb-6 text-2xl font-bold md:text-4xl'>
      Últimas noticias de Steam
    </h2>
    <BlogList posts={posts} />
  </main>
</Layout>
